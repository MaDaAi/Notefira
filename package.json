{
  "name": "notefira",
  "private": true,
  "version": "0.1.4",
  "description": "Notefira — offline-first handwriting, PDF annotation and study notebook app",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "node scripts/sync-version.mjs && node scripts/licenses.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "build:fast": "node scripts/sync-version.mjs && node scripts/licenses.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "tauri": "tauri",
    "desktop:build": "tauri build",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.1.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.2",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
