# Cache rules for free static hosts that read a _headers file (Cloudflare Pages, Netlify).
# The service worker, page shell and theme script must always be re-checked so updates
# reach people; the hashed build files in /assets never change and can be cached forever.

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/theme-init.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
