{
  "name": "Notefira",
  "short_name": "Notefira",
  "description": "Handwriting, PDF annotation and study notebooks that work offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#151414",
  "theme_color": "#151414",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/notefira-library-wide.png",
      "sizes": "1920x916",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Notefira notebook library with demo notebooks"
    }
  ],
  "shortcuts": [
    {
      "name": "New notebook",
      "short_name": "New notebook",
      "description": "Create a new Notefira notebook",
      "url": "./?action=new-notebook",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Import PDF",
      "short_name": "Import PDF",
      "description": "Choose a PDF to import into Notefira",
      "url": "./?action=import-pdf",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-notefira": [
          ".notefira"
        ],
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
